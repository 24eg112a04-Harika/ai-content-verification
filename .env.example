# Copy to .env and adjust before `docker compose up`
# All values below are development defaults.

# --- Application ---
APP_PORT=10000
# Demo accounts (admin@verification.org / admin@123, analyst@verification.org / analyst@123)
# and one sample verification record are seeded on first start.
# Set to "false" in production.
SEED_DEMO_DATA=true

# --- JWT (REQUIRED in production) ---
# Random string of at least 64 characters, e.g. `openssl rand -hex 48`
JWT_SECRET=

# --- MySQL ---
MYSQL_DATABASE=content_verification_db
MYSQL_USER=verisource
MYSQL_PASSWORD=verisource_secret_change_me
MYSQL_ROOT_PASSWORD=verisource_root_change_me

# --- Optional integrations (DEMO = built-in heuristics + Wikipedia API) ---
AI_PROVIDER=DEMO
AI_API_KEY=
SEARCH_PROVIDER=DEMO
SEARCH_API_KEY=

# --- CORS (only relevant when running the React dev server separately) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000
